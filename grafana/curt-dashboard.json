      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "country",
        "barWidth": 0.6,
        "showValue": "auto",
