    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Devices",
      "description": "Device type, people only. Not verified against live services.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ae}"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ae}"
          },
          "query": "SELECT if(blob6 = '', '(unknown)', blob6) AS device, SUM(_sample_interval * double1) AS clicks FROM curt_clicks WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob3 = 'ok' AND blob7 = '0' GROUP BY device ORDER BY clicks DESC LIMIT 10",
          "rawQuery": "SELECT if(blob6 = '', '(unknown)', blob6) AS device, SUM(_sample_interval * double1) AS clicks FROM curt_clicks WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob3 = 'ok' AND blob7 = '0' GROUP BY device ORDER BY clicks DESC LIMIT 10",
          "format": "table",
          "editorMode": "sql",
