      "type": "timeseries",
      "title": "Outcomes",
      "description": "Every recorded request by result, bots included. Not verified against live services.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ae}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ae}"
          },
          "query": "SELECT intDiv(toUInt32(timestamp), $interval) * $interval * 1000 AS t, blob3 AS outcome, SUM(_sample_interval * double1) AS requests FROM curt_clicks WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) GROUP BY t, outcome ORDER BY t",
          "rawQuery": "SELECT intDiv(toUInt32(timestamp), $interval) * $interval * 1000 AS t, blob3 AS outcome, SUM(_sample_interval * double1) AS requests FROM curt_clicks WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) GROUP BY t, outcome ORDER BY t",
          "format": "time_series",
          "editorMode": "sql",
          "datasourceMode": "Datasource",
          "dateTimeType": "DATETIME",
