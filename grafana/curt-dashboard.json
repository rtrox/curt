        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bots and people",
      "description": "Successful redirects, split by the bot flag. Not verified against live services.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${ae}"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${ae}"
          },
          "query": "SELECT intDiv(toUInt32(timestamp), $interval) * $interval * 1000 AS t, if(blob7 = '1', 'Bots', 'People') AS visitor, SUM(_sample_interval * double1) AS clicks FROM curt_clicks WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob3 = 'ok' GROUP BY t, visitor ORDER BY t",
          "rawQuery": "SELECT intDiv(toUInt32(timestamp), $interval) * $interval * 1000 AS t, if(blob7 = '1', 'Bots', 'People') AS visitor, SUM(_sample_interval * double1) AS clicks FROM curt_clicks WHERE timestamp >= toDateTime($from) AND timestamp <= toDateTime($to) AND blob3 = 'ok' GROUP BY t, visitor ORDER BY t",
          "format": "time_series",
          "editorMode": "sql",
          "datasourceMode": "Datasource",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "table": "curt_clicks",
          "round": "0s",
          "intervalFactor": 1,
          "interval": "5m",
          "extrapolate": false,
          "skip_comments": true,
          "adHocFilters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/People/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/Bots/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
