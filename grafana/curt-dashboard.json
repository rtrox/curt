            "fillOpacity": 85
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "device",
        "barWidth": 0.6,
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
